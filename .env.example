# このファイルを .env にコピーして値を埋めてください（.env は .gitignore 済み）。
#   cp .env.example .env

# ── LLM ───────────────────────────────────────────────────
# Arm A / B / C すべてで同一モデルを使う（SPEC §4-2: アーム間でモデルを揃えること）。
# Claude Agent SDK は Claude Code のログイン認証を流用できるため、
# ANTHROPIC_API_KEY は「未設定でも動く」場合があります。明示したい場合のみ設定してください。
ANTHROPIC_API_KEY=

# 全アーム共通で使うモデル。結果の meta.json に必ず記録されます。
WRB_MODEL=claude-sonnet-5

# ── 埋め込み（Arm A / C）──────────────────────────────────
# 既定はローカル埋め込み。API キー不要・課金なし・CI で再現可能。
# 限界が見えたら WRB_EMBEDDING_BACKEND=openai に切り替える。
WRB_EMBEDDING_BACKEND=local
WRB_EMBEDDING_MODEL=BAAI/bge-m3

# OpenAI 埋め込みに移行する場合のみ必要
OPENAI_API_KEY=
