# ── 秘匿情報 ─────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 仮想環境 ─────────────────────────────────────────────
.venv/
venv/

# ── 生成コーパス（スクリプトで再生成できるのでコミットしない）──
# 同 seed なら同じものが再生成される（tests/test_determinism.py で保証）
corpus/

# ── 実行結果の中間物 ─────────────────────────────────────
# results/<run_id>/ 自体は成果物なのでコミットする（figures と scored.csv）。
# ただし生の LLM 応答キャッシュは重いので除外。
.cache/
results/**/raw_responses/

# ── モデルキャッシュ（BGE-m3 等のダウンロード先）──────────
.models/

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# ── OS / エディタ ────────────────────────────────────────
.DS_Store
Thumbs.db
